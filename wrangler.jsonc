{
  // Serves the built site (dist) and runs worker/ai-proxy.ts only for /api/* requests.
  // "name" must match the existing Worker in the Cloudflare dashboard, or a second Worker will be created.
  "name": "craft-your-cv",
  "main": "worker/ai-proxy.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Each visitor (by IP) may make 5 AI requests per minute. period must be 10 or 60. Needs wrangler 4.36 or newer.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
